# Copy to worker/.env for local runs. NEVER commit real keys.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com) for email alerts. Optional locally.
RESEND_API_KEY=
ALERT_FROM_EMAIL=Pricewatch <onboarding@resend.dev>

# Comma-separated emails checked on the Pro schedule without a subscription. Optional.
OWNER_EMAILS=
